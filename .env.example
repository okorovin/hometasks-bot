# Telegram Bot
BOT_TOKEN=your_telegram_bot_token
ALLOWED_TELEGRAM_IDS=123456789,987654321

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/hometasks

# LLM (OpenAI-compatible)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_api_key
LLM_MODEL=gpt-4o-mini

# Web UI
JWT_SECRET=your_random_secret_at_least_32_chars
WEB_URL=http://localhost:3000
PORT=3000

# Gmail hourly digest (optional — leave blank to disable)
# Create an OAuth client of type "Desktop app" in Google Cloud (enable Gmail API),
# then run `npm run gmail:auth` to obtain the refresh token.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Recipient chat id for the digest; defaults to the single ALLOWED_TELEGRAM_IDS entry
GMAIL_NOTIFY_TELEGRAM_ID=

# Environment
NODE_ENV=development
